{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akari-photo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "port": 8792,
    "host": "localhost"
  },
  // The feedback worker owns api.joinakari.com as a custom domain and serves
  // other paths there, so these path routes run in front of it only for /photo,
  // /meal and /compose; a catch-all api.joinakari.com/* would swallow the feedback API.
  "routes": [
    {
      "pattern": "api.joinakari.com/photo*",
      "zone_name": "joinakari.com"
    },
    {
      "pattern": "api.joinakari.com/meal",
      "zone_name": "joinakari.com"
    },
    {
      "pattern": "api.joinakari.com/compose",
      "zone_name": "joinakari.com"
    }
  ],
  "vars": {
    "DEVICE_DAILY_CAP": "80",
    "ADDRESS_DAILY_CAP": "240",
    "GLOBAL_DAILY_CAP": "6000"
  },
  // Daily at 03:00 UTC: delete counter and salt rows older than yesterday.
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "COUNTERS",
      "database_name": "akari-photo-counters",
      "database_id": "fd804d03-9eba-44b7-b69d-8bdc0a2d5680",
      "migrations_dir": "migrations"
    }
  ]
}
