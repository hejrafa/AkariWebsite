{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akari-food-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ADMIN_HOST": "admin.joinakari.com",
    "API_HOST": "api.joinakari.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akari-food-feedback",
      "database_id": "REPLACE_AFTER_CREATION",
      "migrations_dir": "migrations"
    }
  ]
}
