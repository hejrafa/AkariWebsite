{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akari-food-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "admin.joinakari.com",
      "custom_domain": true
    },
    {
      "pattern": "api.joinakari.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ADMIN_HOST": "admin.joinakari.com",
    "API_HOST": "api.joinakari.com",
    "ADMIN_EMAIL": "contact@hejrafa.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akari-food-feedback",
      "database_id": "5603fc8b-bca6-4453-ba32-ab4375f21ab1",
      "migrations_dir": "migrations"
    }
  ]
}
